---
import wiki from 'virtual:chronowiki/config';
import { useI18n } from '../i18n';

const { t, href } = useI18n(Astro);
---

<footer class="site-footer">
  <div class="page site-footer__inner">
    <p class="site-footer__lead">
      {t('footer.lead', { site: wiki.name })}
      <a href={href('/about/#corrections')}>{t('footer.correct')}</a>.
    </p>
    <ul class="site-footer__links" role="list">
      <li><a href={href('/about/')}>{t('footer.method')}</a></li>
      <li><a href={href('/about/#confidence')}>{t('footer.dates')}</a></li>
      {wiki.repository && <li><a href={wiki.repository}>{t('footer.code')}</a></li>}
      {wiki.license && <li><a href={wiki.license.url} rel="license">{t('footer.license', { license: wiki.license.name })}</a></li>}
    </ul>
  </div>
</footer>
