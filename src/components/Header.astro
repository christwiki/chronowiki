---
import wiki from 'virtual:chronowiki/config';
import { useI18n, type MessageKey } from '../i18n';

interface Props {
  section?: string;
}

const { section } = Astro.props;
const i18n = useI18n(Astro);
const { t, href } = i18n;

const NAV: { id: string; label: MessageKey; path: string }[] = [
  { id: 'timeline', label: 'nav.timeline', path: '/' },
  { id: 'map', label: 'nav.map', path: '/map/' },
  { id: 'threads', label: 'nav.threads', path: '/threads/' },
  { id: 'people', label: 'nav.people', path: '/people/' },
  { id: 'places', label: 'nav.places', path: '/places/' },
  { id: 'sources', label: 'nav.sources', path: '/sources/' },
  ...(wiki.book ? [{ id: 'book', label: 'nav.book' as MessageKey, path: '/book/' }] : []),
  { id: 'about', label: 'nav.about', path: '/about/' },
];

// The language switch appears as soon as the site is built in more than one language.
const languages = i18n.alternates(Astro.url.pathname);
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="brand" href={href('/')} aria-label={t('nav.home', { site: wiki.name })}>
      <svg class="brand__mark" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true">
        <path d="M12 2v20" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
        <circle cx="12" cy="7" r="3" fill="var(--accent)"></circle>
        <circle cx="12" cy="16.5" r="2.25" fill="var(--bg)" stroke="currentColor" stroke-width="1.5"></circle>
      </svg>
      <span class="brand__name">{wiki.name}</span>
    </a>

    <nav class="site-nav" aria-label={t('nav.label')}>
      <ul role="list">
        {
          NAV.map((item) => (
            <li>
              <a href={href(item.path)} aria-current={section === item.id ? 'page' : undefined}>
                {t(item.label)}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="site-header__tools">
      {
        languages.length > 1 && (
          <nav class="language-switch" aria-label={t('nav.language')}>
            <ul role="list">
              {languages.map((language) => (
                <li>
                  <a
                    href={language.href}
                    lang={language.code}
                    hreflang={language.code}
                    aria-current={language.current ? 'true' : undefined}
                    title={language.name}
                  >
                    {language.code.toUpperCase()}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        )
      }
      <button class="tool-button" type="button" data-search-open aria-label={t('nav.search')} aria-keyshortcuts="/">
        <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
          <circle cx="8.5" cy="8.5" r="5.75" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
          <path d="m13 13 4.5 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
        </svg>
        <span class="tool-button__text">{t('nav.search')}</span>
        <kbd aria-hidden="true">/</kbd>
      </button>
      <button class="tool-button tool-button--icon" type="button" data-theme-toggle aria-label={t('nav.theme')}>
        <svg class="icon-sun" viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
          <circle cx="10" cy="10" r="3.5" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
          <path
            d="M10 1.75v2M10 16.25v2M1.75 10h2M16.25 10h2M4.2 4.2l1.4 1.4M14.4 14.4l1.4 1.4M4.2 15.8l1.4-1.4M14.4 5.6l1.4-1.4"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"></path>
        </svg>
        <svg class="icon-moon" viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
          <path
            d="M16.5 12.2A7 7 0 0 1 7.8 3.5a7 7 0 1 0 8.7 8.7Z"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linejoin="round"></path>
        </svg>
      </button>
    </div>
  </div>
</header>
