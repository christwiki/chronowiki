---
/** The words of the page for an address that does not exist, in the page's language. */
import { useI18n } from '../i18n';

const { t, href } = useI18n(Astro);
---

<div class="page page--narrow not-found">
  <p class="label">404</p>
  <h1>{t('notFound.heading')}</h1>
  <p class="lead">{t('notFound.lead')}</p>
  <p class="not-found__links">
    <a class="button" href={href('/')}>{t('notFound.toTimeline')}</a>
    <button class="button button--quiet" type="button" data-search-open>{t('notFound.search')}</button>
  </p>
</div>

<style>
  .not-found {
    padding-block: var(--space-9);
  }

  .not-found h1 {
    margin-top: var(--space-2);
    font-size: var(--step-3);
  }

  .not-found .lead {
    margin-top: var(--space-3);
    color: var(--ink-muted);
  }

  .not-found__links {
    margin-top: var(--space-5);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
</style>
